{
  "name": "farmhackai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:safety && npm run test:monitoring && npm run test:guidance && npm run test:rate-limit && npm run test:follow-up && npm run test:reminders && npm run test:errors && npm run test:eval",
    "test:safety": "node --test --experimental-strip-types scripts/safety.test.mjs",
    "test:monitoring": "node --test --experimental-strip-types scripts/monitoring.test.mjs",
    "test:guidance": "node --test --experimental-strip-types scripts/guidance.test.mjs",
    "test:rate-limit": "node --test --experimental-strip-types scripts/rate-limit.test.mjs",
    "test:follow-up": "node --test --experimental-strip-types scripts/follow-up.test.mjs",
    "test:reminders": "node --test --experimental-strip-types scripts/reminders.test.mjs",
    "test:errors": "node --test --experimental-strip-types scripts/errors.test.mjs",
    "test:eval": "node --test --experimental-strip-types evaluation/scoring.test.mjs",
    "test:integration": "node --env-file-if-exists=.env --import ./evaluation/loader.mjs --experimental-strip-types --test scripts/integration.test.mjs",
    "eval": "node --env-file-if-exists=.env --import ./evaluation/loader.mjs --experimental-strip-types evaluation/runner.mjs",
    "eval:validate": "npm run eval -- --mode validate",
    "eval:check": "npm run eval -- --mode selfcheck",
    "eval:record": "npm run eval -- --mode record",
    "eval:replay": "npm run eval -- --mode replay",
    "db:check:auth": "node scripts/check-auth-schema.mjs",
    "db:migrate:auth": "node scripts/migrate-auth-schema.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed:guidance": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed-guidance.mjs",
    "auth:provision-admin": "node scripts/provision-admin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/generative-ai": "^0.24.1",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "cn": "^0.5.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
